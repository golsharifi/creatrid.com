# Database
DATABASE_URL="postgres://creatrid:creatrid_dev@localhost:5432/creatrid?sslmode=disable"

# JWT
JWT_SECRET=""  # Generate with: openssl rand -base64 32

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# URLs
BACKEND_URL="http://localhost:8080"
FRONTEND_URL="http://localhost:3000"

# GitHub OAuth (optional)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Twitter/X OAuth 2.0 (optional)
TWITTER_CLIENT_ID=""
TWITTER_CLIENT_SECRET=""

# LinkedIn OAuth (optional)
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# Instagram / Facebook OAuth (optional)
INSTAGRAM_CLIENT_ID=""
INSTAGRAM_CLIENT_SECRET=""

# Dribbble OAuth (optional)
DRIBBBLE_CLIENT_ID=""
DRIBBBLE_CLIENT_SECRET=""

# Behance / Adobe OAuth (optional)
BEHANCE_CLIENT_ID=""
BEHANCE_CLIENT_SECRET=""

# Cookie settings
COOKIE_DOMAIN=""        # Empty for localhost, ".creatrid.com" for production
COOKIE_SECURE="false"   # "true" for production (requires HTTPS)

# Frontend env (create frontend/.env.local with this)
NEXT_PUBLIC_API_URL="http://localhost:8080"

# AI assistant — Brand Studio + Legal AI (optional; features disabled if unset)
ANTHROPIC_API_KEY=""

# Per-task AI models (optional). "claude-*" ids use the Anthropic API; any other
# id (e.g. deepseek-chat) is sent to the OpenAI-compatible endpoint below and
# falls back to the Claude default if that endpoint isn't configured.
# Defaults: logos=claude-opus-4-8, copy/refine=claude-haiku-4-5, legal=claude-sonnet-4-6
AI_MODEL_LOGOS=""
AI_MODEL_COPY=""
AI_MODEL_REFINE=""
AI_MODEL_LEGAL=""

# OpenAI-compatible provider for non-Claude models (DeepSeek direct, or a US
# host like Fireworks/Together). Base URL without trailing /chat/completions,
# e.g. "https://api.deepseek.com/v1"
AI_COMPAT_BASE_URL=""
AI_COMPAT_API_KEY=""

# Trade: the closed-loop sticker exchange is always live. This flag gates ONLY
# the external portion (transferable crypto IDs, public NFT markets, Polymarket)
# — keep false until securities/CFTC legal sign-off is in writing.
# NEXT_PUBLIC_ENABLE_TRADE="false"

# Online music stations on /music — player is production-ready; enable once the
# client holds streaming/public-performance licenses and licensed stream URLs
# are configured in frontend/src/app/music/page.tsx (ONLINE_STATIONS).
# NEXT_PUBLIC_ENABLE_STREAMING="false"
